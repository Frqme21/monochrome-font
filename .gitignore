# The built fonts in fonts/ ARE committed - a typeface is the deliverable, and
# most visitors want to download the .ttf rather than run the generator.
# Only stray editor/OS noise is ignored.

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Tool scratch directories
.cache/

# Specimen output (regenerate with tools/specimen.py or tools/html_specimen.py)
/specimen.png
/*-specimen.png
/monochrome-aviation-specimen.html

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
